# Frontend environment (copy to .env.local for overrides; .env* is gitignored).
#
# Local dev leaves this UNSET — the app uses "/api", which Vite proxies to the
# backend on http://localhost:8083 (see vite.config.ts). Set this only when the
# backend has a public URL (hosting phase), e.g.:
# VITE_API_BASE_URL=https://your-api.example.com/api
